{
  "name": "redline",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.14.1",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -Apt run build",
    "dev": "yarn workspace @redline/extension dev",
    "typecheck": "yarn workspaces foreach -Ap run typecheck",
    "test": "vitest run",
    "test:e2e:chrome": "yarn workspace @redline/extension test:e2e:chrome",
    "test:e2e:firefox": "yarn workspace @redline/extension test:e2e:firefox",
    "lint": "prettier --check packages claude e2e-fixtures nix .claude-plugin '*.md' package.json .prettierrc.yml",
    "format": "prettier --write packages claude e2e-fixtures nix .claude-plugin '*.md' package.json .prettierrc.yml"
  },
  "devDependencies": {
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "^6",
    "vite": "^8.2.0",
    "vitest": "^5.0.5"
  }
}
